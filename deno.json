{
  "workspace": [
    "./packages/cli"
  ],
  "imports": {
    "@hooksmith/core": "jsr:@hooksmith/core@^0.8.1",
    "@hooksmith/runtime": "jsr:@hooksmith/runtime@^0.8.1",
    "@cliffy/command": "jsr:@cliffy/command@^1.2.1",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/fs": "jsr:@std/fs@^1",
    "@std/path": "jsr:@std/path@^1",
    "@std/yaml": "jsr:@std/yaml@^1"
  },
  "tasks": {
    "check": "deno fmt --check && deno lint && deno test -A",
    "test": "deno test -A",
    "cli": "deno run -A packages/cli/mod.ts"
  },
  "fmt": {
    "exclude": [
      "README.md"
    ]
  },
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": [
      "jsr:@hooksmith/core",
      "jsr:@hooksmith/runtime"
    ]
  },
  "lock": false
}
