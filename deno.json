{
  "workspace": [
    "./packages/cli"
  ],
  "imports": {
    "@hooksmith/core": "jsr:@hooksmith/core@^0.10.0",
    "@hooksmith/opentelemetry": "jsr:@hooksmith/opentelemetry@^0.10.0",
    "@hooksmith/runtime": "jsr:@hooksmith/runtime@^0.10.0",
    "@opentelemetry/api": "npm:@opentelemetry/api@^1.9.0",
    "@opentelemetry/context-async-hooks": "npm:@opentelemetry/context-async-hooks@^2.1.0",
    "@opentelemetry/sdk-trace-base": "npm:@opentelemetry/sdk-trace-base@^2.1.0",
    "@cliffy/command": "jsr:@cliffy/command@^1.2.1",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/fs": "jsr:@std/fs@^1",
    "@std/path": "jsr:@std/path@^1",
    "@std/yaml": "jsr:@std/yaml@^1"
  },
  "tasks": {
    "check": "deno fmt --check && deno lint && deno test -A",
    "test": "deno test -A",
    "cli": "deno run -A packages/cli/mod.ts"
  },
  "fmt": {
    "exclude": [
      "README.md"
    ]
  },
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": [
      "jsr:@hooksmith/core",
      "jsr:@hooksmith/opentelemetry",
      "jsr:@hooksmith/runtime"
    ]
  },
  "lock": false
}
